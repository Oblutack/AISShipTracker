# Free API key from https://aisstream.io - sign up, no approval wait.
AISSTREAM_API_KEY=

# Port the tracker's own HTTP/WebSocket server listens on.
PORT=8090

# Optional bounding box to limit subscription volume to one region
# (lat/lon corners). If any of these four are missing, the tracker
# subscribes to the whole world instead - much higher message volume.
# Example below covers roughly the North Sea / English Channel.
BBOX_MIN_LAT=48
BBOX_MIN_LON=-5
BBOX_MAX_LAT=62
BBOX_MAX_LON=10
